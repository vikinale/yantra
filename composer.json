{
  "autoload": {
    "psr-4": {
      "System\\": "System/",
      "Core\\": "Core/",
      "Utilities\\": "System/Utilities/",
      "Config\\": "App/Config/",
      "Controllers\\": "App/Controllers/",
      "Models\\": "App/Models/"
    }
  },
  "require": {
    "php": ">=8.0",
    "ext-pdo": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-redis": "*",
    "phonepe/phonepe-pg-php-sdk": "^1.0",
    "psr/log": "^1.1 || ^3.0",
    "phpmailer/phpmailer": "^7.0",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "laminas/laminas-httphandlerrunner": "^2.13"
  },
  "repositories": [
    {
      "type": "package",
      "package": [
        {
          "dist": {
            "type": "zip",
            "url": "https://phonepe.mycloudrepo.io/public/repositories/phonepe-pg-php-sdk/phonepe-pg-php-sdk.zip"
          },
          "name": "phonepe/phonepe-pg-php-sdk",
          "version": "1.0.0",
          "autoload": {
            "classmap": ["/"]
          }
        }
      ]
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "*"
  }
}
